{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "out/**"]
		},
		"test": {
			"dependsOn": ["build"],
			"cache": false
		},
		"check": {
			"dependsOn": ["build"],
			"cache": false
		},
		"lint": {
			"dependsOn": ["^build"]
		},
		"lint:skills": {
			"dependsOn": ["build"],
			"cache": true,
			"inputs": ["../../plugins/**", "src/**"]
		}
	}
}
